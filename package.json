{
  "name": "@pi-vault/pi-providers",
  "version": "0.2.1",
  "type": "module",
  "description": "Pi extension that adds MiniMax and StepFun custom model providers",
  "author": "Lanh Hoang <lanhhoang@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/pi-vault/pi-providers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-vault/pi-providers.git"
  },
  "bugs": {
    "url": "https://github.com/pi-vault/pi-providers/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "pi-extension",
    "pi-providers",
    "custom-providers",
    "minimax",
    "stepfun",
    "openai-compatible"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:dry-run": "pnpm pack --dry-run",
    "pack:verify": "node scripts/verify-pack.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm pack:verify"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "src",
    "docs/assets",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^26.1.1",
    "typebox": "^1.3.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
