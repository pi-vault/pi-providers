{
  "name": "@pi-vault/pi-providers",
  "version": "0.3.1",
  "type": "module",
  "description": "Pi extension that adds MiniMax, StepFun, and Command Code model providers plus a TypeSafe Jev decision tool",
  "author": "Lanh Hoang <lanhhoang@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/pi-vault/pi-providers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-vault/pi-providers.git"
  },
  "bugs": {
    "url": "https://github.com/pi-vault/pi-providers/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "pi-extension",
    "pi-providers",
    "custom-providers",
    "minimax",
    "stepfun",
    "command-code",
    "typesafe",
    "jev",
    "openai-compatible"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:dry-run": "pnpm pack --dry-run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "src",
    "docs/assets",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^26.6.3",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
